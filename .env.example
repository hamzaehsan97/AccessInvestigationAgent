# OpenRouter API key (required for live LLM calls; not needed for --offline)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides
AGENT_DB_PATH=input_data/access_snapshot.sqlite

# Model routing
AGENT_MODEL_PLANNER=openai/gpt-4o-mini
AGENT_MODEL_EXECUTOR=openai/gpt-4o-mini
AGENT_MODEL_VERIFIER=openai/gpt-4.1-mini

AGENT_MAX_TOOL_CALLS=15
AGENT_MAX_WALL_SECONDS=90
AGENT_RUN_STORE_DIR=runs
